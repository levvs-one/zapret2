root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{dart,yaml,yml,json}]
indent_style = space
indent_size = 2

[*.{cc,cpp,h}]
indent_style = space
indent_size = 2

[*.{ps1,iss}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false
